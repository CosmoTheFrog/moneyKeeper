# Внутренний Caddy: HTTPS и сертификат снаружи даёт Caddy tracker-bot, сюда приходит plain HTTP.
:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy moneykeeper-app:8090
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Хешированные файлы неизменны, HTML нет: WebView Telegram кэширует агрессивно.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@html path *.html /
	header @html Cache-Control "no-cache"
}
